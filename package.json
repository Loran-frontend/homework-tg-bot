{
  "name": "homework-tg-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "prisma generate && tsc",
    "test": "node --import tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "node scripts/prisma-deploy.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "dotenv": "^16.6.1",
    "grammy": "^1.38.4"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
